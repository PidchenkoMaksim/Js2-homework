// num 5

const girls = [
  { age: 23, name: "Оля" },
  { age: 29, name: "Аня" },
  { age: 10, name: "Юля" },
  { age: 20, name: "Катя" },
];

let sum = 0;

for (let girl of girls) {
  sum += girl.age;
}

const average = sum / girls.length;

console.log("середній вік:", average);
